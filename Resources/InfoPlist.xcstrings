      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Al-Adhan"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأذان"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاذان"
          }
        }
      },
      "comment" : "Bundle display name: the name under the icon",
      "extractionState" : "extracted_with_value"
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Al-Adhan uses your location to calculate your prayer times and Qibla direction. Only Al-Adhan and Apple ever see it, and it is never shared with anyone else."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تطبيق الأذان موقعك لحساب مواقيت الصلاة واتجاه القبلة. لا يراه إلا تطبيق الأذان وApple، ولا يُشارَك مع أي أحد آخر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاذان ایپ نماز کے اوقات اور قبلہ کی سمت معلوم کرنے کے لیے آپ کا مقام استعمال کرتی ہے۔ اسے صرف الاذان ایپ اور Apple دیکھتے ہیں، اور یہ کبھی کسی اور کے ساتھ شیئر نہیں کیا جاتا۔"
          }
        }
      },
      "comment" : "Privacy: Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value"
    },
